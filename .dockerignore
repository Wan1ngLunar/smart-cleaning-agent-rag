# 不把Git仓库内部数据发送给Docker。
.git/

# 不复制本地IDE配置。
.idea/
.vscode/

# 不复制Windows上创建的Python虚拟环境。
.venv/

# 不复制Python缓存和测试产生的临时文件。
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# 绝不能把真实密钥打包进镜像。
.env
.env.*
!.env.example

# 不复制本地运行产生的数据库、索引、日志和备份。
storage/
logs/
*.log
local_backup/

# 测试和评估文件不参与生产运行，减少镜像构建内容。
tests/
evaluation/
requirements-dev.txt
