# Copy this file to .env and replace the placeholder with your own key.
DASHSCOPE_API_KEY=replace_with_your_dashscope_api_key
# Streamlit访问FastAPI后端的地址；本机开发使用8000端口。
API_BASE_URL=http://127.0.0.1:8000
# qwen3-rerank需要业务空间专用的compatible-api地址。
DASHSCOPE_RERANK_BASE_URL=https://replace_with_your_workspace_id.cn-beijing.maas.aliyuncs.com/compatible-api/v1
